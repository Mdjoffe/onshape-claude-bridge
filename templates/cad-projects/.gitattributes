# If you decide to track exports, LFS keeps them out of the git object store.
# Delete the matching lines from .gitignore for any pattern you enable here.
*.step filter=lfs diff=lfs merge=lfs -text
*.stp  filter=lfs diff=lfs merge=lfs -text
*.stl  filter=lfs diff=lfs merge=lfs -text
*.3mf  filter=lfs diff=lfs merge=lfs -text

# FeatureScript is source. Keep it plain text with normalized endings.
*.fs text eol=lf
